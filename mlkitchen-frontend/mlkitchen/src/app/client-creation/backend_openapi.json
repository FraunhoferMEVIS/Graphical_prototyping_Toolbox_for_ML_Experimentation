                        100,
                        200,
                        400,
                        800
                      ]
                    }
                  }
                }
              },
              {
                "language": "python",
                "library": "sklearn",
                "name": "LogisticRegression"
              }
            ],
            "feature_selection": {
              "name": "SelectKBest",
              "parameters": {
                "k": 25,
                "score_func": "mutual_info_regression"
              }
            },
            "imputation": [
              {
                "all_numerical": true,
                "name": "Median"
              }
            ],
            "metrics": [
              {
                "name": "balanced_accuracy_score",
