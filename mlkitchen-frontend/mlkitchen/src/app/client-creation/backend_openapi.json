        "examples": [
          {
            "description": "Predicting in-hospital expiration based on SAPSS-II",
            "encoders": [
              {
                "all_categorical": true,
                "name": "OneHotEncoder",
                "parameters": {
                  "drop": "if_binary",
                  "handle_unknown": "ignore",
                  "sparse_output": false
                }
              },
              {
                "all_numerical": true,
                "name": "StandardScaler"
              }
