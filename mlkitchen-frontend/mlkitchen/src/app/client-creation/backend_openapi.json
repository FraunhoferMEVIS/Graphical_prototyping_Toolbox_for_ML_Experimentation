                "name": "RandomForestClassifier",
                "parameters": {
                  "hyper_parameter_tuning": "RandomizedSearchCV",
                  "search_space": {
                    "max_depth": {
                      "function": "randint",
                      "parameters": {
                        "high": 15,
                        "low": 5
                      }
                    },
                    "n_estimators": {
                      "values": [
