      "ColumnTransformerConfig": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "library": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Library"
          },
          "language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProgrammingLanguages"
              },
              {
                "type": "null"
              }
            ]
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters"
          },
          "column_name": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column Name"
          },
          "all_numerical": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "All Numerical"
          },
          "all_categorical": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "All Categorical"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ColumnTransformerConfig",
        "description": "if column name is given, the method will be applied only to the specified\ncolumn name. Otherwise, if \"all_numerical\" is equal to True, the method\nwill be applied to all numerical columns, and/or if \"all_categorical\" is\nequal to True, the method will be applie to all categorical columns of\nthe dataset. If none of these inputs are set, the method is applied to\nall columns, except for Identifier columns, e.g. subject_id."
      },
      "DataTypes": {
        "type": "string",
        "enum": [
          "numerical",
          "categorical"
        ],
        "title": "DataTypes",
        "description": "Different types of input columns"
      },
      "Filters": {
        "type": "string",
        "enum": [
          "plot",
          "timeseries_classification",
          "estimator_based",
          "numerical",
          "categorical",
          "grid",
          "oversampling",
          "classification",
          "statistical_based",
          "over_undersampling",
          "undersampling",
          "score_for_classification",
          "regression",
          "score_for_regression"
        ],
        "title": "Filters",
        "description": "list of all possible filters"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
